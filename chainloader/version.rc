#pragma code_page(65001)
// dfhooks.dll（橋渡し役）のバージョン情報。VER_NUM / VER_STR は build.rs が version.h に書く
#include "version.h"

1 VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEOS 0x40004L
FILETYPE 0x2L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", "higesho"
      VALUE "ProductName", "Dwarf Fortress 日本語化パッチ（非公式）"
      VALUE "FileDescription", "Dwarf Fortress 日本語化パッチ（非公式）"
      VALUE "FileVersion", VER_STR
      VALUE "ProductVersion", VER_STR
      VALUE "InternalName", "dfhooks"
      VALUE "OriginalFilename", "dfhooks.dll"
      VALUE "Comments", "https://higesho.github.io/df-ja/"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0411, 1200
  END
END
